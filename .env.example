# NAMUNA fayl. Haqiqiy qiymatlar FAQAT `.env` da turadi (u gitga tushmaydi).
# Bu faylga hech qachon ishlaydigan kalit yozilmaydi.

# Google Gemini API kaliti — https://aistudio.google.com/apikey dan oling
GEMINI_API_KEY=

# Azure Speech kaliti — Azure portalida "Speech service" resursi yarating
# (bepul F0 tarifi ham yetarli): Keys and Endpoint bo'limidan KEY 1 ni oling
AZURE_SPEECH_KEY=

# Azure resursi joylashgan region (resurs yaratganda tanlaganingiz)
AZURE_SPEECH_REGION=northeurope

# O'zbekcha ovoz: erkak — uz-UZ-SardorNeural, ayol — uz-UZ-MadinaNeural
AZURE_VOICE=uz-UZ-SardorNeural

# Ixtiyoriy: Gemini Live modelini almashtirish (standart:
# gemini-2.5-flash-native-audio-preview-12-2025; muqobil: gemini-3.1-flash-live-preview)
# GEMINI_LIVE_MODEL=

# Ixtiyoriy: TTS gapirish tezligi (SSML prosody rate), masalan -10% sekinroq
# TTS_RATE=+0%

# Ixtiyoriy: web server sozlamalari (server.py)
# WEB_HOST=127.0.0.1
# WEB_PORT=8000
# TTS_PITCH=+0%   # ohang balandligi (masalan +4% — yumshoqroq ayol ovozi)

# Ixtiyoriy: talaffuz qatlami (core/normalize.py, ORFOEPIYA_REJA.md)
# UZ_APOSTROPHE=official     # o'/g' belgisi: official (oʻ gʻ ʼ) | straight (') | right (’)
# UZ_ORTHOEPY=on             # off — orfoepiya qoidalari butunlay o'chadi
# UZ_ORTHOEPY_SKIP=          # vergul bilan alohida qoidalar: shs,d_t,t_tushadi ...

# TTS ta'minotchisi:
#   azure  — Azure uz-UZ neyro-ovoz (talaffuz qatlami to'liq ishlaydi)
#   yandex — Alisa texnologiyasi, o'zbekcha Nigora ovozi
#   gemini — Gemini Live modelining O'Z ovozi (Azure kaliti shart emas, zaxirada
#            qoladi; talaffuz qatlami ovozga TA'SIR QILMAYDI — model o'zi gapiradi)
# Yandex kaliti: console.yandex.cloud -> service account (ai.speechkit-tts.user roli) -> API key
# TTS_PROVIDER=azure
# YANDEX_API_KEY=
# YANDEX_VOICE=nigora
# GEMINI_VOICE=             # gemini rejimi uchun prebuilt ovoz (Kore, Aoede, Puck...); bo'sh — standart
