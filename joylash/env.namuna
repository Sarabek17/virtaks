# =============================================================================
#  Virtaks — DigitalOcean droplet muhiti
#
#  NUSXA OLING, KEYIN TO'LDIRING:      cp env.namuna .env && nano .env
#  `.env` gitga TUSHMAYDI. Bu faylga hech qachon ishlaydigan kalit yozilmaydi.
#
#  Parollarni o'ylab topmang, generatsiya qiling:
#      openssl rand -base64 30 | tr -d '/+=' | cut -c1-32
#
#  QIYMATLARDA bo'shliq, tirnoq va dollar belgisi BO'LMASIN:
#  docker compose dollarni o'zgaruvchi deb o'qiydi, skriptlar esa
#  tirnoqda qoqiladi. Yuqoridagi generator ularni allaqachon kesadi.
# =============================================================================

# --- Domen va TLS ------------------------------------------------------------
# DOMEN ning A-yozuvi shu dropletning IP siga qarab turishi SHART, aks holda
# Caddy sertifikat ololmaydi va sayt ochilmaydi.
DOMEN=twin.virtaks.uz
PUBLIC_URL=https://twin.virtaks.uz
# Let's Encrypt shu manzilga sertifikat muddati haqida ogohlantiradi.
ACME_EMAIL=virtakstechnical@gmail.com

# --- PostgreSQL (konteyner ichida) -------------------------------------------
# PG_URL ni bu yerga YOZMANG — u docker-compose.yml da shu uchtadan quriladi.
PG_BAZA=virtaks
PG_USER=virtaks
PG_PAROL=

# --- Fayl ombori (MinIO, konteyner ichida) -----------------------------------
# Shu ikkitasi MinIO ning root kaliti ham, ilovaning S3 kaliti ham.
# S3_KIRISH kamida 3, S3_MAXFIY kamida 8 belgi bo'lishi shart (MinIO talabi).
S3_KIRISH=virtaks
S3_MAXFIY=
# Baket nomi ESKI SERVERDAGIDEK qolsin — bazadagi s3_yol qiymatlari
# baket ichidagi kalitlar, ular ko'chirishda o'zgarmaydi.
S3_BAKET=kengash

# --- Model va bot ------------------------------------------------------------
GEMINI_API_KEY=
TELEGRAM_BOT_TOKEN=
# Jiddiy xatolar shu Telegram chat/kanal ID siga yuboriladi (monitoring.py).
XATO_TG_KANAL=

# --- To'lov: Paylov ----------------------------------------------------------
# Callback login/parol Paylov KABINETIDA ham AYNAN shunday yozilishi shart.
PAYLOV_MERCHANT_ID=
PAYLOV_CALLBACK_LOGIN=
PAYLOV_CALLBACK_PAROL=
# 1 — summa tiyinda, 0 — so'mda. Jonli 1000 so'mlik to'lov bilan tasdiqlanadi.
PAYLOV_TIYINDA=1
# Vergul bilan ajratilgan callback IP oq ro'yxati. Bo'sh bo'lsa filtr o'chiq.
PAYLOV_IP=

# --- To'lov: Click / Payme (ixtiyoriy) ---------------------------------------
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET=
PAYME_MERCHANT_ID=
PAYME_KEY=

# --- Pochta (ixtiyoriy) ------------------------------------------------------
# Kirish faqat Telegram orqali bo'lgani uchun majburiy emas.
RESEND_API_KEY=
POCHTA_FROM=

# --- Xavfsizlik bayroqlari ---------------------------------------------------
# IKKALASI HAM BO'SH QOLSIN. Har biri jonli tizimda teshik ochadi:
#   DEV_KIRISH=1    — parolsiz kirish (auth.dev_rejim)
#   ZAXIRA_KIRISH=1 — login/parol eshigi, faqat Telegramdan ayrilib qolganda
#   KENGASH_BOT_OFF=1 — botni o'chiradi, webhook o'rnatilmaydi
DEV_KIRISH=
ZAXIRA_KIRISH=
KENGASH_BOT_OFF=
